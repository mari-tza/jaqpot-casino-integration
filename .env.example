# Copy to .env. If DB_PORT is changed for docker compose, update the port here too.
DATABASE_URL="postgresql://jaqpot:jaqpot_secret@localhost:5432/jaqpot"
PORT=3000

# HMAC secrets, one per direction (the header names the receiver).
CASINO_SECRET="casino-hmac-secret-change-in-production"
PROVIDER_SECRET="provider-hmac-secret-change-in-production"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
